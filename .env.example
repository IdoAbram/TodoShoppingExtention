# Copy to .env.local (never commit real values).

# --- Microsoft sign-in (Entra ID app registration, see README) ---
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# "common" = personal + work/school accounts. Use "consumers" for personal accounts only.
MS_TENANT=common
# Public URL of the app (no trailing slash). Optional: defaults to the request's own URL.
# APP_URL=https://your-app.vercel.app

# Only these Microsoft accounts may sign in (comma-separated). Empty = anyone.
ALLOWED_EMAILS=

# --- Groq (sorts items into supermarket sections) ---
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b

# --- Upstash Redis (category DB, sessions, section order) ---
# Added automatically by the Vercel "Upstash for Redis" integration
# (it may name them KV_REST_API_URL / KV_REST_API_TOKEN; both are supported).
# Without them, local development stores data in .data/kv.json.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Local preview without Microsoft (fake list). Never set this in production. ---
# DEMO_MODE=1
